# ====================================================================
# CampusHub Environment Variables
# ====================================================================

# Connect your Supabase project (Find in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin scripts only (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
